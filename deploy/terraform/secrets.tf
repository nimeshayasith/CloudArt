# ── SECRETS AND SERVER SETTINGS ────────────────────────────────────────────────────────────────────────────
# The passwords are generated by Terraform, never typed or stored in git. They live (a) in Terraform's state, which is in a
# private encrypted bucket, and (b) in ONE encrypted SSM parameter that the server reads when the app is deployed.

resource "random_password" "db" {
  length  = 32
  special = false # letters and digits only, so it is safe inside the DATABASE_URL
}

resource "random_password" "origin" {
  length  = 48
  special = false
}

# The whole ".env.prod" file as one SecureString. The deploy script on the server downloads it, so the file is created on
# Linux with Unix line endings (copying a file from Windows would put a stray carriage return into every value).
resource "aws_ssm_parameter" "env" {
  name        = "/cloudart/prod/env"
  description = "CloudArt production server settings (.env.prod)"
  type        = "SecureString"
  tier        = "Standard"
  value = replace(templatefile("${path.module}/templates/env.prod.tftpl", {
    region            = var.region
    log_group         = local.log_group
    db_password       = random_password.db.result
    origin_secret     = random_password.origin.result
    site_origin       = "https://${aws_cloudfront_distribution.main.domain_name}"
    uploads_bucket    = aws_s3_bucket.this["uploads"].bucket
    backups_bucket    = aws_s3_bucket.this["backups"].bucket
    cognito_pool_id   = aws_cognito_user_pool.main.id
    cognito_client_id = aws_cognito_user_pool_client.web.id
    admin_email       = var.admin_email
  }), "\r", "")

  tags = { Component = "settings" }
}
