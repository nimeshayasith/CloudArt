# The server's settings and secrets. The passwords are generated by Terraform, never typed or stored in git. They live
# (a) in Terraform's state, which is in a private encrypted bucket, and (b) in ONE encrypted SSM parameter that the server reads
# when the application is deployed.

resource "random_password" "db" {
  length  = 32
  special = false # letters and digits only, so it is safe inside the DATABASE_URL
}

# The whole ".env.prod" file as one SecureString. The deploy script on the server downloads it, so the file is created on Linux
# with Unix line endings (copying a file from Windows would put a stray carriage return into every value).
resource "aws_ssm_parameter" "env" {
  name        = var.parameter_name
  description = "CloudArt production server settings (.env.prod)"
  type        = "SecureString"
  tier        = "Standard"
  value = replace(templatefile("${path.module}/templates/env.prod.tftpl", {
    region            = var.region
    log_group         = var.log_group_name
    db_password       = random_password.db.result
    origin_secret     = var.origin_verify_secret
    site_origin       = var.site_origin
    uploads_bucket    = var.uploads_bucket
    backups_bucket    = var.backups_bucket
    cognito_pool_id   = var.cognito_pool_id
    cognito_client_id = var.cognito_client_id
    admin_email       = var.admin_email
  }), "\r", "")

  tags = { Component = "settings" }
}
