# CloudArt production settings. Generated by Terraform and stored as the encrypted SSM parameter /cloudart/prod/env.
# The deploy script on the server writes this file to /opt/cloudart/.env.prod (mode 600). Do not edit by hand:
# change the Terraform variables and apply, then deploy again.

# ── used by docker-compose.prod.yml
API_IMAGE=cloudart-api:latest
AWS_REGION=${region}
LOG_GROUP=${log_group}

# ── PostgreSQL (container "db")
POSTGRES_USER=cloudart
POSTGRES_PASSWORD=${db_password}
POSTGRES_DB=cloudart_db

# ── the API
NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://cloudart:${db_password}@db:5432/cloudart_db?schema=public
DB_SSL=off
CORS_ORIGIN=${site_origin}
TRUST_PROXY=1
ORIGIN_VERIFY_SECRET=${origin_secret}
STORAGE_DRIVER=s3
S3_BUCKET=${uploads_bucket}
COGNITO_REGION=${region}
COGNITO_USER_POOL_ID=${cognito_pool_id}
COGNITO_APP_CLIENT_ID=${cognito_client_id}
WHATSAPP_COMMUNITY_URL=

# ── one-time admin bootstrap (node prisma/seed.js); empty = no admin seeded yet
ADMIN_EMAIL=${admin_email}
ADMIN_FULL_NAME=CloudArt Admin
ADMIN_USERNAME=admin

# ── used by the nightly backup script on the server
BACKUP_BUCKET=${backups_bucket}
