# Copy to .env.prod ON THE SERVER and fill in. Never commit .env.prod (it is git-ignored).
# Generate secrets with:  openssl rand -hex 24

# ── image and logging (used by docker-compose.prod.yml)
API_IMAGE=123456789012.dkr.ecr.ap-south-1.amazonaws.com/cloudart-api:latest
AWS_REGION=ap-south-1
LOG_GROUP=/cloudart/prod/api

# ── PostgreSQL (container "db"). Use letters and digits only in the password so it is safe inside the URL below.
POSTGRES_USER=cloudart
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=cloudart_db

# ── the API
NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://cloudart:CHANGE_ME@db:5432/cloudart_db?schema=public
DB_SSL=off

# Your CloudFront address (no trailing slash). The site and the API share it, so this is also the allowed origin.
CORS_ORIGIN=https://dxxxxxxxxxxxx.cloudfront.net

# One proxy (CloudFront) sits in front of the API.
TRUST_PROXY=1
# Must equal the X-Origin-Verify header you configure on the CloudFront origin (at least 24 characters).
ORIGIN_VERIFY_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE

# Uploaded files go to a private S3 bucket through the server's IAM role (no keys on the server).
STORAGE_DRIVER=s3
S3_BUCKET=cloudart-prod-uploads-ACCOUNTID
AWS_REGION=ap-south-1

# Amazon Cognito: the PRODUCTION pool (not the development one).
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
COGNITO_APP_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX

# One-time admin bootstrap, used only by `node prisma/seed.js`.
ADMIN_EMAIL=
ADMIN_FULL_NAME=CloudArt Admin
ADMIN_USERNAME=admin

WHATSAPP_COMMUNITY_URL=
