# Copy to .env — never commit .env
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://cloudart:cloudart_dev_password@localhost:5433/cloudart_db?schema=public

# One-time admin bootstrap (used by `npm run db:seed`)
ADMIN_EMAIL=
ADMIN_FULL_NAME=CloudArt Admin
ADMIN_USERNAME=admin

# Amazon Cognito (Phase 2)
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=ap-south-1_KXQljZJGU
COGNITO_APP_CLIENT_ID=49dh9ld22gg5kvoq84i9vrk77a
WHATSAPP_COMMUNITY_URL=

# Private folder for payment screenshots (local dev). Never served directly; admins view them through the API.
UPLOAD_DIR=uploads
