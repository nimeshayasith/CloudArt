# Copy to .env — never commit .env
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://cloudart:cloudart_dev_password@localhost:5433/cloudart_db?schema=public

# One-time admin bootstrap (used by `npm run db:seed`)
ADMIN_EMAIL=
ADMIN_FULL_NAME=CloudArt Admin
ADMIN_USERNAME=admin

# Amazon Cognito (Phase 2)
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
